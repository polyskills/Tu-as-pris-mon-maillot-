{
  "name": "tu-as-pris-mon-maillot",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @maillot/web dev",
    "dev:api": "pnpm --filter @maillot/api dev",
    "build": "pnpm --filter @maillot/web build && pnpm --filter @maillot/api build",
    "start": "node apps/api/dist/server.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "migrate": "pnpm --filter @maillot/api migrate",
    "catalogue": "pnpm --filter @maillot/domain catalogue"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.10"
}
