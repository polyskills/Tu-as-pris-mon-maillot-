{
  "name": "tu-as-pris-mon-maillot",
  "private": true,
  "workspaces": [
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maillot/web",
    "build": "npm run build -w @maillot/web",
    "start": "npm run start -w @maillot/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "catalogue": "npm run catalogue -w @maillot/domain"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
