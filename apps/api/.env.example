# Copier en .env et adapter. Ne jamais versionner le fichier .env.

# Base MariaDB / MySQL dédiée à l'outil
DATABASE_URL="mysql://maillot:MOT_DE_PASSE@localhost:3306/maillot"
# Uniquement pour créer des migrations en développement
SHADOW_DATABASE_URL="mysql://maillot:MOT_DE_PASSE@localhost:3306/maillot_shadow"

# Adresse publique de l'outil (interface + API derrière le même domaine)
PUBLIC_URL="http://localhost:3000"
PORT=4000

# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères
# (ex. : openssl rand -base64 32)
BETTER_AUTH_SECRET="a-remplacer"

# Envoi des e-mails de connexion.
# Développement et site DEV : Mailpit capte tous les e-mails (SMTP 127.0.0.1:1025, lecture sur http://127.0.0.1:8025).
# PROD : un vrai service d'envoi (Brevo, OVH…), port 587.
# Sans SMTP_HOST, le lien est affiché dans les logs (développement uniquement).
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Tu as pris mon maillot <no-reply@adaptools.fr>"
